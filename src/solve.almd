// The loop: observe, read, edit, verify, repeat.
//
// Nothing is decided until the thing it depends on has been observed, and
// the model is asked one small question at a time. Every rule here was
// paid for on a benchmark run; the comments say which.

import env
import json
import self.llm
import self.ask
import self.reference
import self.observe
import self.notes
import self.diffing
import self.editing
import self.saving
import self.looking
import self.reading
import self.prompts
import self.pacing
import self.results

// `verify_timeout_ms` is the same number the baseline observation ran under. It used to be
// a fixed 120 s here while `--timeout` changed only the baseline, so a slow test suite
// passed its first run and timed out on every attempt after it.
// `strong_model` is where the ladder's last rung goes. A benchmark that compares agents
// on one model sets it to that model, so more attempts cannot also mean a bigger model.
type Options = { max_attempts: Int, max_files: Int, model: String, allow_create: Bool, quiet: Bool, polish: Int, polish_only: Bool, explore: Int, verify_timeout_ms: Int, strong_model: String }

// Where a run stands between attempts. `unusable` counts attempts that produced no
// edit worth running and drives the ladder; `stuck` counts the same failure twice in a
// row and climbs one rung; `polishing` is the extra attempt that only simplifies, and
// `succeeded` that a PASS was reached and kept.
type Run = { attempts: List[results.Attempt], warnings: List[String], cost: Float, paths: List[String], history: String, harness_broken: String,
  unverified: Bool, unusable: Int, last_ms: Int, stuck: Int, last_key: String, n: Int, finished: Bool, polishing: Bool, polish_left: Int,
  succeeded: Bool, polish_kept: Bool?, snapshot: List[(String, String)], originals: List[(String, String)] }

// What every attempt of a run is given, and does not change.
type Given = { creds: llm.Credentials, obs: observe.Observation, opts: Options, context: String, retry_context: String, findings: String }

effect fn solve(creds: llm.Credentials, task: String, obs: observe.Observation, opts: Options) -> Result[results.Outcome, String] = {
  let started = env.millis()
  let quiet = opts.quiet
  let dirty_before = results.changed_files(obs.root)!
  let baseline_excerpt = match obs.baseline { some(b) => looking.failure_view(b.command, b.stdout + "\n" + b.stderr, obs.root, 60, quiet)!, none => "" }
  let lang = option.map(obs.fingerprint, (f) => f.language) ?? ""
  let ref = reference.reference_for(obs.root, lang)!
  if not quiet and ref.label != "" then eprintln("  reference: " + ref.label)
  if not quiet and ref.label == "" and lang != "" then eprintln("  reference: (none for " + lang + ")")
  // Two renderings, both pure and both built once: the first attempt sees the baseline
  // test output, every later one does not. See `render_observation` for why.
  let context = looking.render_observation(obs, task, baseline_excerpt, reference.render(ref), true)
  let retry_context = looking.render_observation(obs, task, "", reference.render(ref), false)

  // Nothing to do, and saying so is the whole answer: run against a green
  // project the loop once replaced a working file with prose. `polish_only` is
  // the one caller that wants a green project: it has nothing to fix and only
  // wants the code said more simply, so it starts where solve would stop.
  if (option.map(obs.baseline, (b) => b.code == 0) ?? false) and not opts.polish_only then already_passing(obs, started)
  else {
    notes.phase(quiet, "select", "")!
    let (paths, select_cost) = chosen_paths(creds, context, obs, opts, ref.path)!
    let (findings, explore_cost) = explored(creds, context, obs, opts)!
    let g = Given { creds: creds, obs: obs, opts: opts, context: context, retry_context: retry_context, findings: findings }
    var r = Run { attempts: [], warnings: [], cost: select_cost + explore_cost, paths: paths, history: "", harness_broken: "", unverified: false,
      unusable: 0, last_ms: 0, stuck: 0, last_key: "", n: 1, finished: false, polishing: opts.polish_only,
      polish_left: if opts.polish_only then 0 else opts.polish, succeeded: opts.polish_only, polish_kept: none,
      snapshot: if opts.polish_only then saving.snapshot_of(obs.root, paths)! else [], originals: [] }
    while not r.finished and (r.n <= opts.max_attempts or r.polishing) { r = attempt(g, r)! }
    outcome_of(g, r, dirty_before, started)
  }
}

effect fn already_passing(obs: observe.Observation, started: Int) -> Result[results.Outcome, String] = {
  let (count, ms) = ask.throttle_waits()!
  ok(results.Outcome { ok: true, attempts: [], changed: [], cost_usd: 0.0, wall_ms: env.millis() - started,
    warnings: ["the verify command already passes: `" + obs.verify_command + "` exited 0 before anything ran, so nothing was changed"],
    harness_broken: "", polish_kept: none, unverified: false, diff: "", throttled: count, throttled_ms: ms })
}

// The files to read, and what choosing them cost.
effect fn chosen_paths(creds: llm.Credentials, context: String, obs: observe.Observation, opts: Options, ref_path: String) -> Result[(List[String], Float), String] = {
  let (selected, cost) = looking.select_files(creds, context, obs, opts.max_files, opts.model, opts.quiet)!
  // The file that supplied the LANGUAGE REFERENCE is already in the prompt, whole.
  // Reading it again as a source file sends it twice, every attempt: on the Almide
  // exercise benchmark that is CHEATSHEET.md at 41,210 characters, so 82,420 go out
  // where 41,210 would do, and the duplicate competes for the same budget as the code
  // the model actually has to change. `small_project_sources` cannot see the
  // collision -- it only skips build files -- so the filter belongs here, where the
  // reference is known.
  let paths = looking.paths_to_read(selected, ref_path)
  if list.len(paths) < list.len(selected) then notes.note(opts.quiet, "not re-reading " + ref_path + ": it is the language reference, already in the prompt")!
  if not opts.quiet then eprintln("  reading: " + (if list.is_empty(paths) then "(nothing)" else string.join(paths, ", ")))
  ok((paths, cost))
}

// Looking around, before anything is changed. Off unless `--explore N` asks for it, so
// a run that has a verify command behaves exactly as it did before.
effect fn explored(creds: llm.Credentials, context: String, obs: observe.Observation, opts: Options) -> Result[(String, Float), String] = {
  var findings = ""
  var cost = 0.0
  var round = 0
  while round < opts.explore {
    notes.phase(opts.quiet, "explore", int.to_string(round + 1) + "/" + int.to_string(opts.explore))!
    let (seen, c) = looking.explore_round(creds, context + findings, obs.root, opts.model, opts.quiet)!
    cost = cost + c
    findings = findings + seen
    round = round + 1
  }
  ok((findings, cost))
}

// One attempt: the files read as they are now, the model asked for edits, the edits
// written, the verify command run, and what the next attempt needs to know.
effect fn attempt(g: Given, r: Run) -> Result[Run, String] = {
  let quiet = g.opts.quiet
  let started_at = env.millis()
  let (throttled_before, throttled_ms_before) = ask.throttle_waits()!
  notes.phase(quiet, "edit", if r.polishing then "polish" else "attempt " + int.to_string(r.n) + "/" + int.to_string(g.opts.max_attempts))!
  let (block, read) = reading.render_files(g.obs.root, r.paths, quiet)!
  // A polish is included: it runs after a PASS, so a failing baseline is stale
  // there too, and it is the one request that is shown no history at all.
  // What exploration found stays in every attempt's prompt. It was paid for once and it
  // does not go stale the way the baseline diagnostic does: `ls` output and a compiler's
  // opinion of the untouched code describe the task, not the last edit.
  let seen = (if r.polishing or r.history != "" then g.retry_context else g.context) + g.findings
  let prompt = prompts.edit_prompt(seen, block, r.history, r.polishing, g.obs.verify_command)
  let (model, max_tokens, effort) = pace(g.opts, r)!
  let a = without_silence(ask_edits(g, r.originals, prompt, read, model, max_tokens, effort)!)
  let unusable = unusable_after(r.unusable, a, quiet)!
  let (verify, passed, broken) = checked(g, a, r.n, started_at, throttled_before, throttled_ms_before)!
  let unverified_now = a.apply_error == "" and g.obs.verify_command == ""
  let ms = env.millis() - started_at
  let tried = results.Attempt { n: r.n, read: read, edits: a.edits, rejected: a.rejected, apply_error: a.apply_error, verify: verify, cost_usd: a.cost, ms: ms, explanation: a.explanation, ok: passed }
  // No verify command: the edits are written and that is the end of it. This used to
  // fall through to the next attempt, where the history said "result: FAILED" with no
  // reason, and the model rewrote a change nobody had found anything wrong with -- up
  // to --attempts times, each one paid for. A retry needs a failure to learn from.
  let ran = { ...r, attempts: r.attempts + [tried], cost: r.cost + a.cost, originals: a.originals, unusable: unusable, last_ms: ms,
    harness_broken: if broken != "" then broken else r.harness_broken, finished: r.finished or broken != "" or unverified_now,
    unverified: r.unverified or unverified_now, warnings: r.warnings + (if unverified_now then ["no verify command: success was not checked"] else []) }
  let settled = polished(g, ran, passed, read)!
  let next = if settled.finished then settled else learned(g, settled, a, verify)!
  ok({ ...next, n: next.n + 1 })
}

// Which model, how much output and how much reasoning this attempt gets: the ladder's
// rung, lowered by the latency guard (see `budget_after`).
effect fn pace(opts: Options, r: Run) -> Result[(String, Int, String), String] = {
  let rung = pacing.rung_for(r.unusable + r.stuck)
  let (max_tokens, effort) = pacing.budget_after(r.last_ms, rung, r.unusable + r.stuck > 0)
  if r.last_ms > pacing.SLOW_ATTEMPT_MS then notes.note(opts.quiet, "last attempt took " + int.to_string(r.last_ms / 1000) + "s; this one gets " + effort + " reasoning and " + int.to_string(max_tokens) + " output tokens")!
  // `effort`, not `rung.effort`: this note used to print what the ladder asked for
  // while the guard was quietly using something lower, so the two notes contradicted
  // each other in the log and neither named what was actually sent.
  if r.unusable > 0 then notes.note(opts.quiet, "last attempt produced nothing usable; reasoning=" + effort + (if rung.strong then ", model=" + opts.strong_model else ""))!
  ok((if rung.strong then opts.strong_model else opts.model, max_tokens, effort))
}

// What one attempt got from the model and wrote: the edits applied, what was refused,
// the diffs, what it cost, and the files as they were before this run first wrote them.
type Answer = { edits: List[editing.Edit], explanation: String, rejected: List[editing.Rejected], apply_error: String, diffs: List[String],
  cost: Float, originals: List[(String, String)] }

// Two rounds, not two attempts: an answer refused for its shape is a formatting slip,
// and is asked again once with the reasons.
effect fn ask_edits(g: Given, originals: List[(String, String)], prompt: String, read: List[String], model: String, max_tokens: Int, effort: String) -> Result[Answer, String] = {
  let first = one_round(g, prompt, read, model, max_tokens, effort, Answer { edits: [], explanation: "", rejected: [], apply_error: "", diffs: [], cost: 0.0, originals: originals })!
  if not list.is_empty(first.edits) or list.is_empty(first.rejected) or first.apply_error != "" then ok(first)
  else {
    let repair = prompts.repair_prompt(g.obs, first.rejected, g.opts.quiet)!
    notes.note(g.opts.quiet, "every edit was rejected for its shape; asking once more with the reasons, same effort")!
    one_round(g, prompt + repair, read, model, max_tokens, effort, { ...first, rejected: ([]: List[editing.Rejected]) })
  }
}

effect fn one_round(g: Given, prompt: String, read: List[String], model: String, max_tokens: Int, effort: String, before: Answer) -> Result[Answer, String] = {
  let quiet = g.opts.quiet
  let asked = match ask.ask_json(g.creds, prompt, looking.schema(prompts.EDIT_SCHEMA), ask.Options { system: looking.SYSTEM, model: model, max_output_tokens: max_tokens, reasoning_effort: effort }) {
    err(e) => { ...before, apply_error: "model: " + e },
    ok(a) => {
      notes.note_hedges(quiet, a.hedged, a.hedge_wins)!
      let batch = editing.collect_edits(g.obs, a.value, read, g.opts.allow_create, quiet, before.edits)!
      { ...before, cost: before.cost + a.cost_usd, explanation: json.get_string(a.value, "explanation") ?? "", edits: batch.edits,
        rejected: before.rejected + batch.rejected }
    },
  }
  let originals = saving.remember_originals(g.obs.root, asked.originals, list.map(asked.edits, (e) => e.path))!
  let done = editing.apply_edits(g.obs.root, asked.edits, quiet)!
  ok({ ...asked, originals: originals, edits: done.applied, rejected: asked.rejected + done.rejected, diffs: asked.diffs + done.diffs })
}

// An attempt that wrote nothing says why.
fn without_silence(a: Answer) -> Answer =
  if not list.is_empty(a.edits) or a.apply_error != "" then a
  else { ...a, apply_error: if list.is_empty(a.rejected) then "the model produced no edits at all" else "every edit was rejected: " + string.join(list.map(a.rejected, (r) => r.why), "; ") }

effect fn unusable_after(unusable: Int, a: Answer, quiet: Bool) -> Result[Int, String] =
  if not list.is_empty(a.edits) then ok(unusable)
  else if a.apply_error != "" and ask.is_server_timeout(a.apply_error) then {
    notes.note(quiet, "the provider timed out on that request; trying again with less reasoning, not more")!
    ok(int.max(0, unusable - 1))
  } else ok(unusable + 1)

// The verify command, run when the edits were written: its result, whether it passed,
// and why it counts as broken, or "".
effect fn checked(g: Given, a: Answer, n: Int, started_at: Int, throttled_before: Int, throttled_ms_before: Int) -> Result[(observe.CommandResult?, Bool, String), String] =
  if a.apply_error != "" or g.obs.verify_command == "" then ok((none, false, ""))
  else {
    let quiet = g.opts.quiet
    notes.phase(quiet, "verify", "")!
    let v = observe.run(g.obs.verify_command, g.obs.root, g.opts.verify_timeout_ms)!
    let passed = v.code == 0
    if not quiet then eprintln("  " + (if passed then "PASS" else "FAIL") + " (exit " + int.to_string(v.code) + ", " + int.to_string(v.duration_ms) + "ms)")
    notes.note(quiet, "attempt " + int.to_string(n) + " took " + int.to_string((env.millis() - started_at) / 1000) + "s"
      + notes.throttle_note(ask.throttle_waits()!, throttled_before, throttled_ms_before))!
    let broken = results.mid_run_harness_failure(v, g.obs.baseline)
    if broken != "" then notes.note(quiet, "verify command is broken: " + broken)!
    ok((some(v), passed, broken))
  }

// The first PASS is the answer, not the deliverable: the code that gets
// there is the code the model reached for under a failing test, and it
// shows -- deep nesting, one long function, helpers that exist to route
// around a diagnostic. One more attempt says the same thing more simply.
// The verify command stays the judge. A polish that breaks it is rolled
// back and the version that passed is what stays on disk.
effect fn polished(g: Given, r: Run, passed: Bool, read: List[String]) -> Result[Run, String] = {
  let quiet = g.opts.quiet
  if passed and not r.polishing and r.polish_left > 0 then {
    notes.note(quiet, "passed; one attempt to simplify it, rolled back if the verify command stops passing")!
    ok({ ...r, succeeded: true, polish_left: r.polish_left - 1, polishing: true, snapshot: saving.snapshot_of(g.obs.root, read)! })
  } else if r.polishing then {
    if not passed then {
      saving.restore(g.obs.root, r.snapshot)!
      notes.note(quiet, "the simpler version did not pass; rolled back to the version that did")!
    } else notes.note(quiet, "kept the simpler version")!
    ok({ ...r, finished: true, polish_kept: some(passed) })
  } else if passed then ok({ ...r, succeeded: true, finished: true })
  else ok(r)
}

// A failed attempt, told to the next one: why it failed, what the diagnostics mean,
// whether it is the same failure as last time, and any file the failure names.
effect fn learned(g: Given, r: Run, a: Answer, verify: observe.CommandResult?) -> Result[Run, String] = {
  let quiet = g.opts.quiet
  let why = if a.apply_error != "" then a.apply_error
    else match verify {
      some(v) => (if v.timed_out then prompts.hang_note(g.opts.verify_timeout_ms) else "")
        + looking.failure_view(g.obs.verify_command, v.stdout + "\n" + v.stderr, g.obs.root, 40, quiet)!,
      none => "unknown",
    }
  let explanations = match verify {
    some(v) => prompts.explained_diagnostics(g.obs, v.stdout + "\n" + v.stderr, "explained ", quiet)!,
    none => "",
  }
  let checked_failure = a.apply_error == "" and option.is_some(verify)
  let key = if checked_failure then pacing.failure_key(why) else r.last_key
  let same = checked_failure and r.last_key != "" and key == r.last_key
  if same then notes.note(quiet, "same failure as attempt " + int.to_string(r.n - 1) + "; escalating one rung and asking for a different approach")!
  let paths = if r.n < g.opts.max_attempts then looking.widened(g.obs, verify, r.paths, g.opts.max_files, quiet)! else r.paths
  ok({ ...r, stuck: if same then r.stuck + 1 else if checked_failure then 0 else r.stuck, last_key: key, paths: paths,
    history: r.history + prompts.attempt_record(r.n, a.edits, a.explanation, a.diffs, a.rejected, why, if same then prompts.SAME_FAILURE_NOTE else "", explanations) })
}

effect fn outcome_of(g: Given, r: Run, dirty_before: List[String], started: Int) -> Result[results.Outcome, String] = {
  let obs = g.obs
  let changed = results.changed_by_run(obs.root, dirty_before, r.attempts, g.opts.polish_only and r.polish_kept == some(false))!
  let solved = r.succeeded or (option.map(list.last(r.attempts), (a) => a.ok) ?? false)
  let warnings = if solved then r.warnings + results.gaming_warnings(obs, r.attempts, changed)! else r.warnings
  let (throttle_count, throttle_ms) = ask.throttle_waits()!
  ok(results.Outcome { ok: solved, attempts: r.attempts, changed: changed, cost_usd: r.cost, wall_ms: env.millis() - started, warnings: warnings,
    harness_broken: r.harness_broken, polish_kept: r.polish_kept, unverified: r.unverified, diff: diffing.run_diff(obs.root, r.originals)!,
    throttled: throttle_count, throttled_ms: throttle_ms })
}
