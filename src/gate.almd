// The write gate: no file lands on disk unless it still parses.
//
//   1. a configured command — `GOLEMIDE_CHECK_<EXT>="ruff check {}"`
//      (CAIRN_ / MENDIDE_ / FAMULUS5_ / FAMULUS4_CHECK_<EXT> honoured too)
//   2. a built-in syntax-only command the language ships (never a
//      compiler: `rustc` on one file of a project fails on `use crate::…`)
//      — gramide for the languages it has a grammar for when it is on PATH,
//        else the toolchain's
//   3. otherwise the write proceeds and says it was unchecked.
//
// A write goes to a same-directory temp file that keeps the real extension
// (`node --check` refuses a `.tmp`), is checked there, and is renamed into
// place only if it passes. A refused write leaves the original untouched.

import json
import fs
import env
import process
import self.observe

type Checker = { label: String, program: String, args: List[String] }   // `{}` is the file path; label "" = none

// Never a compiler: `rustc` on one file of a project fails on `use crate::…`
// and would refuse correct edits. `rustfmt --emit stdout` is the exception
// that is not one — it parses and never resolves, so it takes a file with
// unresolved imports (exit 0) and refuses an unclosed delimiter (exit 1).
// Java and C++ have no such tool and are left ungated, said out loud.
// The edition matters: `--edition 2021` refuses a let chain, which is valid
// Rust 2024, so a correct write was being refused. 2024 is the current one and
// the least likely to reject code someone is writing today. gramide sits ahead
// of this and takes no position on editions at all.
let BUILTIN = [
  ("rs", "rust", "rustfmt", ["--emit", "stdout", "--edition", "2024", "{}"]),
  ("py", "python", "python3", ["-m", "py_compile", "{}"]),
  ("pyi", "python", "python3", ["-m", "py_compile", "{}"]),
  ("rb", "ruby", "ruby", ["-c", "{}"]),
  ("sh", "shell", "bash", ["-n", "{}"]),
  ("bash", "shell", "bash", ["-n", "{}"]),
  ("go", "go", "gofmt", ["-e", "{}"]),
  ("php", "php", "php", ["-l", "{}"]),
  ("lua", "lua", "luac", ["-p", "{}"]),
  ("js", "javascript", "node", ["--check", "{}"]),
  ("mjs", "javascript", "node", ["--check", "{}"]),
  ("cjs", "javascript", "node", ["--check", "{}"]),
  ("almd", "almide", "almide", ["check", "{}"]),
  ("json", "json", "python3", ["-c", "import json,sys; json.load(open(sys.argv[1]))", "{}"]),
  ("toml", "toml", "python3", ["-c", "import tomllib,sys; tomllib.load(open(sys.argv[1],'rb'))", "{}"]),
]

// Languages with no grammar here and no syntax-only tool of their own. They
// still get the check that cannot be wrong: `gramide balance` reads brackets
// and literals, so it catches a generation that stopped halfway or answered
// with prose, and passes anything a compiler would parse.
let BALANCE_EXTS = ["java", "cpp", "cc", "cxx", "hpp", "hh", "h", "c", "cs", "kt", "scala", "swift", "ts", "tsx", "m", "mm"]

// Compatibility only for older binaries without the languages command.
let LEGACY_GRAMIDE_EXTS = ["almd", "go", "rs"]

let NONE = Checker { label: "", program: "", args: [] }

effect fn on_path(bin: String) -> Bool = (observe.run("command -v " + bin, ".", 5000)!).code == 0

// `GOLEMIDE_CHECK_PY="ruff check {}"` overrides the built-in for `.py`. The
// agent has been called famulus4, famulus5, mendide and golemide; a variable
// someone set under any of those names still works, newest first.
effect fn configured(ext: String) -> Checker? = {
  let key = string.to_upper(ext)
  let raw = string.trim(env.get("GOLEMIDE_CHECK_" + key) ?? env.get("CAIRN_CHECK_" + key) ?? env.get("MENDIDE_CHECK_" + key) ??
    env.get("FAMULUS5_CHECK_" + key) ?? env.get("FAMULUS4_CHECK_" + key) ?? "")
  if raw == "" then none
  else {
    let parts = list.filter(string.split(raw, " "), (p) => p != "")
    let program = list.first(parts) ?? raw
    var args = list.drop(parts, 1)
    if not list.contains(args, "{}") then list.push(args, "{}") else ()
    some(Checker { label: program, program: program, args: args })
  }
}

fn manifest_supports(raw: String, path: String) -> Bool = match json.parse(raw) {
  err(_) => false,
  ok(j) => (json.get_int(j, "schema_version") ?? 0) == 1 and
    list.any(json.get_array(j, "packages") ?? [], (p) => {
      let caps = list.filter_map(json.get_array(p, "capabilities") ?? [], (v) => match value.as_string(v) { ok(s) => some(s), err(_) => none })
      let exts = list.filter_map(json.get_array(p, "extensions") ?? [], (v) => match value.as_string(v) { ok(s) => some(s), err(_) => none })
      list.contains(caps, "check") and list.any(exts, (ext) => string.starts_with(ext, ".") and string.len(ext) > 1 and string.ends_with(path, ext))
    }),
}

effect fn gramide_supports(path: String, ext: String) -> Bool = {
  match process.exec_status_timeout("gramide", ["languages"], 3000) {
    err(_) => false,
    ok(st) => if st.code == 0 then manifest_supports(st.stdout, path)
      else string.contains(st.stderr, "usage: gramide") and list.contains(LEGACY_GRAMIDE_EXTS, ext),
  }
}

// Which check this path gets, in tier order; none is said, not assumed.
effect fn checker_for(path: String) -> Checker = {
  let ext = observe.extension_of(path)
  if ext == "" then NONE
  else match configured(ext)! {
    some(c) => c,
    none =>
      if gramide_supports(path, ext)! then Checker { label: "gramide", program: "gramide", args: ["check", "{}"] }
      else match list.find(BUILTIN, (b) => b.0 == ext) {
        some((_, label, program, args)) => Checker { label: label, program: program, args: args },
        none => if list.contains(BALANCE_EXTS, ext) and on_path("gramide")! then Checker { label: "balance", program: "gramide", args: ["balance", "{}"] } else NONE,
      },
  }
}

// A toolchain that words a syntax error better than a generic parser can.
// Only consulted once the gate has ALREADY refused, so a compiler that would
// reject a correct file for a missing symbol cannot refuse anything here —
// it only gets to say why the refusal happened. gramide answers "unexpected
// `&&`"; `almide check` answers "operator '&&' has been removed. Use 'and'".
let SECOND_OPINION = [("almd", "almide", "almide check"),
  ("rs", "rustfmt", "rustfmt --emit stdout --edition 2024")]

type Verdict = { kind: String, why: String }   // ok | invalid | unavailable

effect fn run_checker(c: Checker, tmp: String) -> Verdict =
  if c.label == "" then Verdict { kind: "ok", why: "" }
  else {
    let args = list.map(c.args, (a) => if a == "{}" then tmp else a)
    match process.exec_status_timeout(c.program, args, 30000) {
      // ask PATH, do not read the error text: a checker that exists and crashed
      // is a different fact from one that is not installed (ADR-0004)
      err(e) => if on_path(c.program)! then Verdict { kind: "invalid", why: e } else Verdict { kind: "unavailable", why: "" },
      ok(st) => if st.code == 0 then Verdict { kind: "ok", why: "" }
        else {
          let msg = string.trim(string.replace(st.stdout + st.stderr, tmp, "<file>"))
          Verdict { kind: "invalid", why: if msg == "" then c.program + ": exit " + int.to_string(st.code) else msg }
        },
    }
  }

type Written = { path: String, bytes: Int, checked: String }   // checked "" = unchecked

// Write `source` to `path` if it passes its checker; an error beginning
// `edit.write:` otherwise, with the original untouched.
effect fn write_checked(path: String, source: String, create: Bool) -> Result[Written, String] =
  if not create and not fs.exists(path) then err("edit.write: " + path + " does not exist (use create to make a new file)")
  else write_gated(path, source)

effect fn explain_refusal(path: String, tmp: String, why: String) -> String = {
  let ext = observe.extension_of(path)
  match list.find(SECOND_OPINION, (s) => s.0 == ext) {
    none => why,
    some((_, bin, cmd)) =>
      if not on_path(bin)! then why
      else {
        let r = observe.run(cmd + " " + observe.shell_quote(tmp), ".", 30000)!
        let said = string.trim(string.replace(r.stdout + r.stderr, tmp, "<file>"))
        if r.code != 0 and said != "" then said else why
      },
  }
}

effect fn write_gated(path: String, source: String) -> Result[Written, String] = {
  let c = checker_for(path)!
  let dir = match string.last_index_of(path, "/") { some(i) => string.take(path, i), none => "." }
  let name = list.last(string.split(path, "/")) ?? path
  let ext = observe.extension_of(path)
  let tmp = dir + "/." + name + ".golemide.tmp" + (if ext == "" then "" else "." + ext)
  fs.write(tmp, source) |> result.map_err((e) => "edit.write: " + e)!
  let v = run_checker(c, tmp)!
  if v.kind == "invalid" then {
    let why = explain_refusal(path, tmp, v.why)!
    let _ = fs.remove(tmp)
    err("edit.write: " + why)
  }
  else {
    fs.rename(tmp, path) |> result.map_err((e) => "edit.write: rename: " + e)!
    ok(Written { path: path, bytes: list.len(string.to_bytes(source)), checked: if v.kind == "ok" and c.label != "" then c.label else "" })
  }
}

test "the gate covers the languages it claims to" {
  // (checker_for is an effect fn; this asserts the table it reads)
  assert(list.any(BUILTIN, (b) => b.0 == "rs" and b.2 == "rustfmt"))
  assert(list.any(BUILTIN, (b) => b.0 == "py"))
  assert(not list.any(BUILTIN, (b) => b.0 == "java" or b.0 == "cpp"))
  // …but they are not ungated: they get the check that cannot be wrong
  assert(list.contains(BALANCE_EXTS, "java"))
  assert(list.contains(BALANCE_EXTS, "cpp"))
  assert(not list.contains(BALANCE_EXTS, "rs"))
}

test "the tiers do not overlap, and gramide is the first of them" {
  // A grammar beats a language tool, which beats brackets. `rs` is in two
  // tables on purpose: gramide gates it, rustfmt only explains a refusal.
  assert(list.contains(LEGACY_GRAMIDE_EXTS, "rs"))
  assert(list.contains(LEGACY_GRAMIDE_EXTS, "go"))
  assert(list.contains(LEGACY_GRAMIDE_EXTS, "almd"))
  assert(not list.any(LEGACY_GRAMIDE_EXTS, (e) => list.contains(BALANCE_EXTS, e)))
  // rustfmt is still in BUILTIN so a machine without gramide is not ungated
  assert(list.any(BUILTIN, (b) => b.0 == "rs"))
  // every second opinion is on a language gramide gates, or it never runs
  assert(list.all(SECOND_OPINION, (s) => list.contains(LEGACY_GRAMIDE_EXTS, s.0)))
  // the edition that refused correct Rust 2024, never again
  assert(list.all(BUILTIN, (b) => not list.contains(b.3, "2021")))
}

test "configured checker parsing adds the placeholder" {
  assert_eq(observe.extension_of("a/b.Py"), "py")
  assert_eq(observe.extension_of("Makefile"), "")
}

test "package capabilities discover new write gates without language branches" {
  let raw = "{\"schema_version\":1,\"packages\":[{\"id\":\"future\",\"extensions\":[\".future\"],\"capabilities\":[\"check\",\"symbols\"]}]}"
  assert(manifest_supports(raw, "src/main.future"))
  assert(not manifest_supports(raw, "src/main.py"))
  assert(not manifest_supports(string.replace(raw, "\"check\",", ""), "src/main.future"))
  assert(not manifest_supports(string.replace(raw, "\"schema_version\":1", "\"schema_version\":2"), "src/main.future"))
  assert(not manifest_supports("{}", "src/main.future"))
}
