// Small, schema-constrained questions to the model, with the retry policy
// famulus5 measured: transient errors back off, rate limits wait up to a
// minute, a budget truncation retries with a larger budget, and a provider
// timeout (408) retries SMALLER — less reasoning and half the budget —
// because the same generation sent into the same wall times out again.

import env
import json
import regex
import self.llm

let MODEL_TRIAGE = "cf:glm-5.3-flash"
let MODEL_WORK = "cf:glm-5.3-flash"
let MODEL_STRONG = "cf:glm-5.3"

type Options = { system: String, model: String, max_output_tokens: Int, reasoning_effort: String }

// (Almide's regex has no case-insensitive flag, no word boundary and no backreference: subjects are lower-cased and
// patterns written in lower case; word edges are spelled out where needed.)
fn is_transient(m: String) -> Bool = regex.is_match("status (408|409|425|429|500|502|503|504)([^0-9]|$)|request timeout|timed? out|econnreset|etimedout|eai_again|socket hang up", string.to_lower(m))
fn is_server_timeout(m: String) -> Bool = regex.is_match("status 408([^0-9]|$)|request timeout", string.to_lower(m))
fn is_budget_truncation(m: String) -> Bool = regex.is_match("truncated before any content|raise max_completion_tokens", string.to_lower(m))
fn is_rate_limit(m: String) -> Bool = regex.is_match("status 429([^0-9]|$)|rate limit|too many requests", string.to_lower(m))
// A truncation in which the reasoning stream, not the answer, consumed the budget. It
// wants the OPPOSITE retry from an answer cut off mid-sentence: less thinking, not more
// room. Measured on glm-5.3 (Workers AI, 2026-09-13) with one prompt at 4096 output
// tokens: `low` finished with 2620 characters of answer after 3269 of reasoning, while
// `high` returned zero characters of answer after 12346 of reasoning and finish=length.
// Reasoning expands to fill what it is given, so tripling the budget on its own buys the
// reasoning three times the room and the answer still never starts.
fn is_reasoning_truncation(m: String) -> Bool = regex.is_match("consumed by reasoning", string.to_lower(m))

let EFFORTS = ["low", "medium", "high"]

// One step less thinking, so the next generation finishes in time.
fn lower_effort(e: String) -> String = {
  let i = list.index_of(EFFORTS, e) ?? 0
  list.get(EFFORTS, int.max(0, i - 1)) ?? "low"
}

// Whether a JSON answer was cut off rather than finished: finished JSON
// ends in `}` or `]`; anything else is a generation the budget stopped.
fn looks_truncated(text: String) -> Bool = {
  let t = string.trim(regex.replace("```\\s*$", string.trim(text), ""))
  if not (string.starts_with(t, "{") or string.starts_with(t, "[")) then false
  // (not a parse attempt: Almide's json.parse accepts an unterminated document)
  else not (string.ends_with(t, "}") or string.ends_with(t, "]"))
}

fn strip_fence(s: String) -> String = match regex.captures("```(?:json|jsonc)?\\s*\\n([\\s\\S]*?)```", s) {
  some(cs) => string.trim(list.get(cs, 1) ?? ""),
  none => "",
}

// The outermost {...} or [...] in the string.
fn slice_braces(s: String) -> String = {
  let starts = list.filter([string.index_of(s, "{") ?? -1, string.index_of(s, "[") ?? -1], (i) => i >= 0)
  match list.min(starts) {
    none => "",
    some(start) => {
      let open = string.get(s, start) ?? "{"
      let close = if open == "{" then "}" else "]"
      match string.last_index_of(s, close) {
        some(e) => if e > start then string.slice(s, start, e + 1) else "",
        none => "",
      }
    },
  }
}

// `,` followed only by whitespace and a closing bracket is dropped
fn drop_trailing_commas(s: String) -> String = {
  let cs = string.chars(s)
  var out: List[String] = []
  var i = 0
  while i < list.len(cs) {
    let c = list.get(cs, i) ?? ""
    if c == "," then {
      var j = i + 1
      while j < list.len(cs) and string.is_whitespace(list.get(cs, j) ?? "") { j = j + 1 }
      let nxt = list.get(cs, j) ?? ""
      if nxt == "}" or nxt == "]" then () else list.push(out, c)
    } else list.push(out, c)
    i = i + 1
  }
  string.join(out, "")
}

// Parse JSON from a model, tolerating what models actually emit: a fence,
// a leading sentence, a trailing comma.
fn parse_json(raw: String) -> Result[Value, String] = {
  var found: Value? = none
  var last = ""
  for a in [raw, strip_fence(raw), slice_braces(raw)] {
    if option.is_none(found) and a != "" then {
      match json.parse(a) {
        ok(v) => { found = some(v) },
        err(e) => match json.parse(drop_trailing_commas(a)) {
          ok(v) => { found = some(v) },
          err(_) => { last = e },
        },
      }
    }
  }
  match found {
    some(v) => ok(v),
    none => err("could not parse model output as JSON (" + last + "): " + string.take(raw, 400)),
  }
}

// Raw model traffic, on CAIRN_DEBUG (MENDIDE_DEBUG still works).
effect fn debug(label: String, body: String) -> Unit =
  if (env.get("GOLEMIDE_DEBUG") ?? env.get("CAIRN_DEBUG") ?? env.get("MENDIDE_DEBUG") ?? "") != "" then eprintln("\n--- " + label + " (" + int.to_string(string.len(body)) + " chars) ---\n" + body + "\n---")

// `hedged`/`hedge_wins` count transport hedges across every retry this ask
// made, so the caller can say what the second requests actually bought.
type Asked = { value: Value, cost_usd: Float, hedged: Int, hedge_wins: Int }

// what one call produced: an answer, or a reason to retry or stop
type Step = | Got(String) | Retry(String)

// 5s, 10s, 20s, 40s, 60s, 60s — enough to outlast a per-minute window
fn backoff(n: Int) -> Int = {
  var w = 5000
  var i = 1
  while i < n and w < 60000 { w = w * 2; i = i + 1 }
  int.min(60000, w)
}

// Every wait on a rate limit (HTTP 429) in this process: how many, and how long in all.
// Kept for the whole run, not per call, so the report can say how much of the wall
// time went to being throttled rather than to working. Measured 2026-09-24: a
// benchmark exercise ran past its 15-minute cap with its tests taking a second, and
// nothing in the log could say whether the model was slow or the account was throttled.
var throttled = 0
var throttled_ms = 0

effect fn throttle_waits() -> (Int, Int) = (throttled, throttled_ms)

effect fn count_throttle(ms: Int) -> Unit = {
  throttled = throttled + 1
  throttled_ms = throttled_ms + ms
}

// What an ask is for, and where it stands between calls: the budget and effort the next
// call goes out at, the retries each kind of failure has had, and what was spent.
type Asking = { creds: llm.Credentials, prompt: String, schema: Value, o: Options }
type Tally = { budget: Int, effort: String, timed_out: Int, attempt: Int, rate_limited: Int, cost: Float, hedged: Int, hedge_wins: Int }

// Ask for a value matching `schema`, and parse it. Constrained decoding on
// Workers AI enforces shape, not size; callers check arity themselves.
effect fn ask_json(creds: llm.Credentials, prompt: String, schema: Value, o: Options) -> Result[Asked, String] = {
  debug("prompt", prompt)!
  ask_from(Asking { creds: creds, prompt: prompt, schema: schema, o: o },
    Tally { budget: o.max_output_tokens, effort: o.reasoning_effort, timed_out: 0, attempt: 0, rate_limited: 0, cost: 0.0, hedged: 0, hedge_wins: 0 })
}

effect fn ask_from(a: Asking, t: Tally) -> Result[Asked, String] = {
  let req = llm.Request { prompt: a.prompt, system: a.o.system, model: a.o.model, max_output_tokens: t.budget, reasoning_effort: t.effort, schema: some(a.schema) }
  let (next, step) = match llm.invoke(a.creds, req) { ok(r) => after_reply(t, r), err(m) => after_error(t, m) }
  match step {
    Got(text) => {
      debug("response", text)!
      match parse_json(text) {
        ok(v) => ok(Asked { value: v, cost_usd: next.cost, hedged: next.hedged, hedge_wins: next.hedge_wins }),
        err(e) => err(e),
      }
    },
    Retry(m) => retried(a, next, m),
  }
}

// A failed call: waited out and sent again, or the end of the ask.
effect fn retried(a: Asking, t: Tally, m: String) -> Result[Asked, String] = {
  let (next, wait) = paced(t, m)
  if wait < 0 then err(if m == "" then "no answer" else m)
  else {
    let ms = if is_rate_limit(m) then wait + env.millis() % 1000 else wait
    if is_rate_limit(m) then count_throttle(ms)!
    debug("retry", m + "\nretrying in " + int.to_string(ms) + "ms")!
    env.sleep_ms(ms)
    ask_from(a, next)
  }
}

fn at(t: Tally) -> String = t.effort + "/" + int.to_string(t.budget)

fn after_reply(t: Tally, r: llm.Response) -> (Tally, Step) = {
  let spent = { ...t, cost: t.cost + r.cost_usd, hedged: t.hedged + (if r.hedged then 1 else 0), hedge_wins: t.hedge_wins + (if r.won_by_hedge then 1 else 0) }
  if looks_truncated(r.text) and t.budget < 65536 then {
    let bigger = { ...spent, budget: int.min(65536, t.budget * 3) }
    (bigger, Retry("response truncated before any content could be parsed (" + int.to_string(string.len(r.text)) + " chars) [retrying at " + int.to_string(bigger.budget) + " output tokens; raise max_completion_tokens]"))
  } else (spent, Got(r.text))
}

fn after_error(t: Tally, m: String) -> (Tally, Step) =
  if is_budget_truncation(m) and (t.budget < 65536 or (is_reasoning_truncation(m) and t.effort != "low")) then {
    // Both levers point the same way here, and only one of them was being
    // pulled: more room for the answer AND less spent before it starts. Without
    // the effort step, a reasoning truncation at `high` retries three times
    // larger and the reasoning simply takes the extra room too -- which is how a
    // call that began at 2048 tokens reached 55296 and still returned nothing.
    let roomier = { ...t, budget: int.min(65536, t.budget * 3), effort: if is_reasoning_truncation(m) then lower_effort(t.effort) else t.effort }
    (roomier, Retry(m + " [retrying at " + at(roomier) + ", was " + at(t) + "]"))
  } else if is_server_timeout(m) then shrunk({ ...t, timed_out: t.timed_out + 1 }, m)
  else (t, Retry(m))

// less thinking and a smaller budget both shorten the generation;
// after two such shrinks a third timeout is the provider's answer
fn shrunk(t: Tally, m: String) -> (Tally, Step) =
  if t.timed_out > 2 then (t, Retry(m + " [gave up after 2 smaller retries]"))
  else {
    let smaller = { ...t, effort: lower_effort(t.effort), budget: int.max(4096, t.budget / 2) }
    (smaller, Retry(m + " [retrying smaller: " + at(t) + " -> " + at(smaller) + "]"))
  }

// How long to wait before the next call (before a rate limit's jitter), or -1 to stop.
fn paced(t: Tally, m: String) -> (Tally, Int) =
  if string.contains(m, "[gave up") or not (is_transient(m) or is_budget_truncation(m)) then (t, -1)
  else if is_rate_limit(m) then {
    let n = t.rate_limited + 1
    ({ ...t, rate_limited: n }, if n > 6 then -1 else backoff(n))
  } else {
    let n = t.attempt + 1
    let wait = if is_budget_truncation(m) or is_server_timeout(m) then (if n >= 5 then -1 else 0)
      else if n >= 3 then -1 else 2000 * n
    ({ ...t, attempt: n }, wait)
  }

test "json parsing tolerates fences, prose and trailing commas" {
  assert(result.is_ok(parse_json("{\"a\": 1}")))
  assert(result.is_ok(parse_json("Here it is:\n```json\n{\"a\": [1, 2,],}\n```")))
  assert(result.is_ok(parse_json("The answer {\"files\": [\"x\"]} done")))
  assert(result.is_err(parse_json("nothing here")))
}

test "a transport timeout is classified as one, so the retry shrinks" {
  // llm.transport_error(28, …) is what a curl deadline produces; ask must
  // read it as a server timeout, or the retry would grow instead of shrink
  assert(is_server_timeout(llm.transport_error(28, "")))
  assert(is_transient(llm.transport_error(28, "")))
  assert(not is_server_timeout(llm.transport_error(6, "could not resolve host")))
  assert(is_transient("status 503: down"))
}

test "truncation detection and the effort ladder" {
  assert(looks_truncated("{\"a\": \"unterminated"))
  assert(not looks_truncated("{\"a\": 1}"))
  assert(not looks_truncated("plain text"))
  assert_eq(lower_effort("high"), "medium")
  assert_eq(lower_effort("low"), "low")
  assert(is_server_timeout("status 408: AiError: Request timeout"))
  assert(is_transient("status 503: down"))
  assert(not is_transient("status 400: bad schema"))
}

test "a reasoning truncation and a starved answer are different failures" {
  let reasoned = "truncated before any content (finish_reason=length, budget consumed by reasoning); spend less on reasoning"
  let starved = "truncated before any content (finish_reason=length); raise max_completion_tokens"
  // Both are budget truncations, so both still retry.
  assert(is_budget_truncation(reasoned))
  assert(is_budget_truncation(starved))
  // Only one of them is asking for less thinking. Telling them apart is the whole point:
  // the retry that raises the budget without lowering the effort hands the extra room to
  // the reasoning, which is what it was already spending everything on.
  assert(is_reasoning_truncation(reasoned))
  assert(not is_reasoning_truncation(starved))
  // The ladder the retry walks down, and its floor: at `low` there is nothing left to
  // give up, so a reasoning truncation there is a real failure rather than a retry.
  assert_eq(lower_effort("high"), "medium")
  assert_eq(lower_effort("medium"), "low")
  assert_eq(lower_effort("low"), "low")
}
