// Reconnaissance: everything the runtime can establish without asking a
// model anything. If the runtime can look it up, the model never gets asked.

import fs
import env
import process
import regex
import json

type Marker = { file: String, language: String, test_command: String, note: String }

// Marker file → ecosystem, most specific first; the first match wins.
let MARKERS = [
  Marker { file: "almide.toml", language: "almide", test_command: "almide test", note: "sources under src/, tests under tests/; run one file with `almide run <file>`" },
  Marker { file: "Cargo.toml", language: "rust", test_command: "cargo test", note: "sources under src/" },
  Marker { file: "go.mod", language: "go", test_command: "go test ./...", note: "tests are *_test.go beside the source" },
  Marker { file: "pyproject.toml", language: "python", test_command: "pytest -q", note: "" },
  Marker { file: "setup.py", language: "python", test_command: "pytest -q", note: "" },
  Marker { file: "setup.cfg", language: "python", test_command: "pytest -q", note: "" },
  Marker { file: "Gemfile", language: "ruby", test_command: "bundle exec rspec", note: "" },
  Marker { file: "pom.xml", language: "java", test_command: "mvn -q test", note: "" },
  Marker { file: "build.gradle", language: "java", test_command: "gradle test", note: "" },
  Marker { file: "build.gradle.kts", language: "kotlin", test_command: "gradle test", note: "" },
  Marker { file: "composer.json", language: "php", test_command: "vendor/bin/phpunit", note: "" },
  Marker { file: "mix.exs", language: "elixir", test_command: "mix test", note: "" },
  Marker { file: "Package.swift", language: "swift", test_command: "swift test", note: "" },
  Marker { file: "pubspec.yaml", language: "dart", test_command: "dart test", note: "" },
  Marker { file: "deno.json", language: "typescript", test_command: "deno test", note: "" },
  Marker { file: "package.json", language: "javascript", test_command: "", note: "read package.json scripts.test — do not assume npm test exists" },
  Marker { file: "CMakeLists.txt", language: "c++", test_command: "ctest", note: "" },
  Marker { file: "Makefile", language: "unknown", test_command: "", note: "check the Makefile for a test target" },
]

type Fingerprint = { marker: String, language: String, test_command: String, note: String }

// package.json is the one marker whose test command is written inside it.
effect fn package_json_test(path: String) -> String = match fs.read_text(path) {
  err(_) => "",
  ok(text) => match json.parse(text) {
    err(_) => "",
    ok(pkg) => {
      let script = match value.field(pkg, "scripts") { ok(s) => json.get_string(s, "test") ?? "", err(_) => "" }
      if script == "" or string.contains(string.to_lower(script), "no test specified") then ""
      else {
        let pm = list.first(string.split(json.get_string(pkg, "packageManager") ?? "", "@")) ?? ""
        (if pm == "pnpm" or pm == "yarn" or pm == "bun" then pm else "npm") + " test"
      }
    },
  },
}

effect fn fingerprint(root: String) -> Fingerprint? = {
  var found: Fingerprint? = none
  for m in MARKERS {
    if option.is_none(found) and fs.exists(root + "/" + m.file) then {
      let cmd = if m.file == "package.json" then package_json_test(root + "/" + m.file)! else m.test_command
      found = some(Fingerprint { marker: m.file, language: m.language, test_command: cmd, note: m.note })
    } else ()
  }
  found
}

// Source extension → language, used only when no marker file matched.
let EXTENSION_LANGUAGE = [("almd", "almide"), ("rs", "rust"), ("go", "go"), ("py", "python"), ("rb", "ruby"), ("ts", "typescript"),
  ("tsx", "typescript"), ("js", "javascript"), ("mjs", "javascript"), ("java", "java"), ("kt", "kotlin"), ("swift", "swift"),
  ("cpp", "c++"), ("cc", "c++"), ("ex", "elixir"), ("exs", "elixir"), ("php", "php")]

fn extension_of(path: String) -> String = {
  let name = list.last(string.split(path, "/")) ?? path
  match string.last_index_of(name, ".") {
    some(i) => if i > 0 then string.to_lower(string.drop(name, i + 1)) else "",
    none => "",
  }
}

fn language_of_ext(ext: String) -> String? = option.map(list.find(EXTENSION_LANGUAGE, (p) => p.0 == ext), (p) => p.1)

// The language most of these files are written in, if one dominates.
fn language_from_files(files: List[String]) -> String? = {
  var counts: Map[String, Int] = [:]
  for f in files {
    match language_of_ext(extension_of(f)) { some(l) => map.insert(counts, l, (map.get(counts, l) ?? 0) + 1), none => () }
  }
  var best: String? = none
  var best_n = 0
  for (l, n) in map.entries(counts) { if n > best_n then { best = some(l); best_n = n } else () }
  best
}

type CommandResult = { command: String, code: Int, stdout: String, stderr: String, timed_out: Bool, duration_ms: Int, spawn_error: String }

// Run a command in `cwd` through `bash -c` (not a login shell: that
// rebuilds PATH and once swapped the user's python3 for another) with a
// deadline. Output is both streams, captured.
//
// The streams go to files rather than the inherited pipes, because a
// command that leaves a background process running keeps those pipes open
// and the runtime waits on them: measured on almide 0.62, a 3-second
// deadline on `sleep 30 & sleep 20` returned after 30 seconds, reporting
// "timed out after 3000ms". Redirected to files the same call returns in
// 3.0 seconds. A test suite that starts a server is the ordinary case here.
effect fn run(command: String, cwd: String, timeout_ms: Int) -> CommandResult = {
  let t0 = env.millis()
  let out_path = fs.create_temp_file("cairn-stdout") ?? ""
  let err_path = fs.create_temp_file("cairn-stderr") ?? ""
  let redirect = if out_path == "" or err_path == "" then ""
    else " > " + shell_quote(out_path) + " 2> " + shell_quote(err_path)
  // a subshell, not a brace group: `{ cmd & ; }` is a bash syntax error and a
  // verify command is allowed to end in `&`
  let script = "cd " + shell_quote(cwd) + " && ( " + command + " )" + redirect
  let status = process.exec_status_timeout("bash", ["-c", script], timeout_ms)
  // whatever was written before the deadline is still what the model needs
  let captured_out = if out_path == "" then "" else (fs.read_text(out_path) ?? "")
  let captured_err = if err_path == "" then "" else (fs.read_text(err_path) ?? "")
  if out_path != "" then { let _ = fs.remove(out_path); () } else ()
  if err_path != "" then { let _ = fs.remove(err_path); () } else ()
  match status {
    ok(st) => CommandResult { command: command, code: st.code,
      stdout: if redirect == "" then st.stdout else captured_out,
      stderr: if redirect == "" then st.stderr else captured_err,
      timed_out: false, duration_ms: env.millis() - t0, spawn_error: "" },
    err(e) => {
      let timed = regex.is_match("time(d)? ?out|deadline", string.to_lower(e))
      CommandResult { command: command, code: -1, stdout: captured_out,
        stderr: captured_err + (if captured_err == "" then "" else "\n") + e,
        timed_out: timed, duration_ms: env.millis() - t0, spawn_error: if timed then "" else e }
    },
  }
}

fn shell_quote(s: String) -> String = "'" + string.replace(s, "'", "'\\''") + "'"

// Build output and binaries, which are never the thing to edit.
let NOISE = "(^|/)(__pycache__|\\.git|node_modules|target|dist|build|out|vendor|\\.venv|venv|\\.pytest_cache|\\.mypy_cache|\\.tox|coverage)(/|$)|\\.(pyc|pyo|class|o|a|so|dylib|dll|exe|jar|war|zip|tar|gz|bz2|xz|7z|png|jpe?g|gif|webp|ico|pdf|woff2?|ttf|eot|mp[34]|mov|wasm)$|(^|/)(package-lock\\.json|yarn\\.lock|pnpm-lock\\.yaml|Cargo\\.lock|poetry\\.lock|composer\\.lock|go\\.sum)$"

fn is_noise(path: String) -> Bool = regex.is_match(NOISE, string.to_lower(path))

// Signatures of a verify command that never ran, as distinct from one that
// ran and failed. Only the first lines: a passing suite can print "No
// module named" inside an expected exception.
let HARNESS_BROKEN = [
  ("no module named (\\S+)", "a Python module is not installed"),
  ("command not found|: not found", "the command is not on PATH"),
  ("enoent", "the executable could not be started"),
  ("is not recognized as an internal or external command", "the command is not on PATH"),
  ("could not find or load main class", "the Java class path is wrong"),
  ("error: no such command", "the subcommand does not exist"),
  ("cannot find module '[^']+'", "a Node module is not installed"),
  ("go: cannot find main module|go\\.mod file not found", "not inside a Go module"),
  ("bundler: command not found|could not find gem", "Ruby gems are not installed"),
  ("no such file or directory\\s*$", "a required file is missing"),
  // a build tool that found no project ran nothing at all
  ("no almide\\.toml found|run 'almide init'", "the directory is not an Almide project (no almide.toml)"),
  ("no targets specified and no makefile found", "there is no Makefile here"),
]

// Why this result should not be read as "the code is wrong"; "" when it ran.
fn harness_failure(r: CommandResult) -> String =
  if r.spawn_error != "" then "the command could not be started: " + r.spawn_error
  else if r.timed_out then "the command timed out"
  else if r.code == 0 then ""
  else {
    let head = string.to_lower(string.join(list.take(string.split(r.stdout + "\n" + r.stderr, "\n"), 12), "\n"))
    var why = ""
    for (re, w) in HARNESS_BROKEN {
      if why == "" then match regex.find(re, head) { some(m) => { why = w + " (" + string.trim(m) + ")" }, none => () } else ()
    }
    why
  }

// Files git considers part of the project (it knows .gitignore); `find`
// with the usual vendor directories pruned when git is not there.
effect fn list_files(root: String, limit: Int) -> List[String] = {
  let r = run("git ls-files --cached --others --exclude-standard 2>/dev/null", root, 15000)!
  var files = list.filter(list.map(string.split(r.stdout, "\n"), (s) => string.trim(s)), (s) => s != "")
  if list.is_empty(files) then {
    let f = run("find . -type d \\( -name node_modules -o -name .git -o -name target -o -name dist -o -name build -o -name vendor -o -name __pycache__ -o -name .venv -o -name venv \\) -prune -o -type f -print", root, 15000)!
    files = list.filter(list.map(string.split(f.stdout, "\n"), (s) => string.trim(string.strip_prefix(s, "./") ?? s)), (s) => s != "")
  } else ()
  list.take(list.filter(files, (f) => not is_noise(f)), limit)
}

// What a truncated file list leaves out, by directory.
fn omitted_by_directory(all: List[String], shown: List[String]) -> String = {
  var counts: Map[String, Int] = [:]
  var order: List[String] = []
  for f in all {
    if not list.contains(shown, f) then {
      let dir = match string.index_of(f, "/") { some(i) => if i > 0 then string.take(f, i) + "/" else "(root)", none => "(root)" }
      if not map.contains(counts, dir) then list.push(order, dir) else ()
      map.insert(counts, dir, (map.get(counts, dir) ?? 0) + 1)
    } else ()
  }
  if list.is_empty(order) then ""
  else {
    let ranked = list.sort_by(order, (d) => 0 - (map.get(counts, d) ?? 0))
    let total = list.sum(list.map(ranked, (d) => map.get(counts, d) ?? 0))
    let head = string.join(list.map(list.take(ranked, 12), (d) => d + " (" + int.to_string(map.get(counts, d) ?? 0) + ")"), ", ")
    let rest = if list.len(ranked) > 12 then ", and " + int.to_string(list.len(ranked) - 12) + " more" else ""
    "… " + int.to_string(total) + " further file(s) not listed, under: " + head + rest
  }
}

type Observation = { root: String, fingerprint: Fingerprint?, verify_command: String, verify_source: String,
  files: List[String], files_omitted: String, repo_map: String, repo_map_warnings: List[String],
  baseline: CommandResult?, harness_broken: String }

// Gather everything observable, once, before any model call. The baseline
// run is the most valuable single item: a failing test names the file, the
// line, the expected value and the actual one.
effect fn observe(root: String, verify_given: String, file_limit: Int, verify_timeout_ms: Int, repo_map: String, repo_map_warnings: List[String]) -> Result[Observation, String] = {
  if not fs.is_dir(root) then err("not a directory: " + root)
  else observe_dir(root, verify_given, file_limit, verify_timeout_ms, repo_map, repo_map_warnings)
}

effect fn observe_dir(root: String, verify_given: String, file_limit: Int, verify_timeout_ms: Int, repo_map: String, repo_map_warnings: List[String]) -> Result[Observation, String] = {
  let fp = fingerprint(root)!
  let (verify_command, verify_source) =
    if verify_given != "" then (verify_given, "user")
    else match fp { some(f) => if f.test_command != "" then (f.test_command, "marker") else ("", "none"), none => ("", "none") }
  let all_files = list_files(root, 1000000)!
  let files = list.take(all_files, file_limit)
  let fingerprint_out = match fp {
    some(f) => some(f),
    none => option.map(language_from_files(files), (l) => Fingerprint { marker: "(no marker file)", language: l, test_command: "", note: "language inferred from the source files, not from a manifest" }),
  }
  let baseline = if verify_command != "" then some(run(verify_command, root, verify_timeout_ms)!) else none
  ok(Observation { root: root, fingerprint: fingerprint_out, verify_command: verify_command, verify_source: verify_source,
    files: files, files_omitted: omitted_by_directory(all_files, files), repo_map: repo_map, repo_map_warnings: repo_map_warnings,
    baseline: baseline, harness_broken: match baseline { some(b) => harness_failure(b), none => "" } })
}

// Keep the last `n` lines — test runners put the failure at the end.
fn tail(s: String, n: Int) -> String = {
  let lines = string.split(s, "\n")
  if list.len(lines) <= n then s else string.join(list.drop(lines, list.len(lines) - n), "\n")
}

type Read = { path: String, content: String, truncated: Bool, error: String }

// hew's machine reader preserves source exactly. An old/malformed provider
// cannot silently turn a prefix into a complete editable file.
fn decode_hew_read(raw: String, full: String, rel: String, limit: Int) -> Result[Read, String] = {
  let j = json.parse(raw)!
  guard (json.get_int(j, "schema_version") ?? 0) == 1 else err("unsupported read schema")
  guard (json.get_string(j, "path") ?? "") == full else err("read path mismatch")
  let content = json.get_string(j, "content") |> option.to_result("missing content")!
  let complete = json.get_bool(j, "complete") |> option.to_result("missing completeness")!
  let total = json.get_int(j, "total_chars") |> option.to_result("missing length")!
  let count = string.len(content)
  guard count <= limit and total >= count else err("invalid read length")
  guard complete == (total == count) else err("inconsistent completeness")
  ok(Read { path: rel, content: content, truncated: not complete, error: "" })
}

effect fn builtin_read(root: String, rel: String, limit: Int) -> Read = match fs.read_text(root + "/" + rel) {
  err(e) => Read { path: rel, content: "", truncated: false, error: e },
  ok(text) => {
    let truncated = string.len(text) > limit
    Read { path: rel, content: if truncated then string.take(text, limit) else text, truncated: truncated, error: "" }
  },
}

effect fn hew_read(full: String, rel: String, limit: Int) -> Result[Read, String] = {
  let st = process.exec_status_timeout("hew", ["read-json", full, "--max-chars", int.to_string(limit)], 20000)!
  guard st.code == 0 else err("hew read failed")
  decode_hew_read(st.stdout, full, rel, limit)
}

// Limits count Unicode characters. Path checks precede either reader.
effect fn read_for_model(root: String, rel: String, max_chars: Int) -> Read = {
  if string.starts_with(rel, "/") or string.contains(rel, "..") then Read { path: rel, content: "", truncated: false, error: "outside the project root" }
  else if fs.is_dir(root + "/" + rel) then Read { path: rel, content: "", truncated: false, error: "is a directory" }
  else match hew_read(root + "/" + rel, rel, max_chars) {
    ok(r) => r,
    err(_) => builtin_read(root, rel, max_chars)!,
  }
}

test "machine reads require truthful completeness and matching paths" {
  let raw = "{\"schema_version\":1,\"path\":\"/project/a\",\"complete\":true,\"content\":\"abc\",\"total_chars\":3}"
  assert(result.is_ok(decode_hew_read(raw, "/project/a", "a", 3)))
  assert(result.is_err(decode_hew_read(raw, "/project/b", "b", 3)))
  assert(result.is_err(decode_hew_read(raw, "/project/a", "a", 2)))
  assert(result.is_err(decode_hew_read(string.replace(raw, "\"total_chars\":3", "\"total_chars\":9"), "/project/a", "a", 3)))
}

test "noise, harness failures, omitted directories" {
  assert(is_noise("src/__pycache__/x.pyc"))
  assert(is_noise("node_modules"))
  assert(not is_noise("src/main.py"))
  let r = CommandResult { command: "pytest", code: 1, stdout: "", stderr: "bash: pytest: command not found", timed_out: false, duration_ms: 1, spawn_error: "" }
  assert(string.starts_with(harness_failure(r), "the command is not on PATH"))
  let no_project = CommandResult { command: "almide test", code: 1, stdout: "No file specified and no almide.toml found.\nRun 'almide init' to create a project.", stderr: "", timed_out: false, duration_ms: 1, spawn_error: "" }
  assert(string.starts_with(harness_failure(no_project), "the directory is not an Almide project"))
  let ok_r = CommandResult { command: "x", code: 1, stdout: "FAILED test_a", stderr: "", timed_out: false, duration_ms: 1, spawn_error: "" }
  assert_eq(harness_failure(ok_r), "")
  assert(string.contains(omitted_by_directory(["a/1", "a/2", "b/3", "c"], ["c"]), "a/ (2)"))
}
