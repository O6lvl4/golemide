// The model call: one prompt, one answer in a JSON shape, through almai.live.
//
// almai.live (almide-ai/almai) holds what used to be here, measured here first and now
// shared with comide: the model ids (cf:..., openai:..., any NAME: with NAME_BASE_URL
// and NAME_API_KEY, claude[:MODEL] for claude -p), the streamed request with curl
// bounding it, the stream folded with Cloudflare's neurons and the cached-token counts,
// the hedge and the wall-clock cap. What stays here is what golemide decides:
//   - "finish_reason=length with empty content" is an error naming the remedy its cause
//     calls for, never an empty answer that silently escalates
//   - how long a call may run before a second copy starts, and before both are stopped
//   - error messages keep the shapes ask.almd classifies on: `status NNN:`,
//     `request timeout`, `truncated before any content`

import env
import almai.live as live

type Request = { prompt: String, system: String, model: String, max_output_tokens: Int, reasoning_effort: String, schema: Value? }
// `hedged` says a second, identical request was started because the first was
// slow; `won_by_hedge` says that second one is the answer being returned. Both
// are here because a hedge that never wins is pure waste, and that cannot be
// told from the outside.
type Response = { text: String, cost_usd: Float, input_tokens: Int, output_tokens: Int, duration_ms: Int, hedged: Bool, won_by_hedge: Bool }

// Kept so callers can pass credentials along; almai reads the environment itself, and
// only a cf: model needs Cloudflare's.
type Credentials = { account_id: String, token: String, email: String, key: String }

let NO_CREDENTIALS = Credentials { account_id: "", token: "", email: "", key: "" }

// A scoped token wins over a Global API Key when both are set. None when
// nothing usable is in the environment (values are never printed).
effect fn credentials_from_env() -> Credentials? = {
  let account = string.trim(env.get("CLOUDFLARE_ACCOUNT_ID") ?? "")
  let token = string.trim(env.get("CLOUDFLARE_API_TOKEN") ?? "")
  let email = string.trim(env.get("CLOUDFLARE_EMAIL") ?? "")
  let key = string.trim(env.get("CLOUDFLARE_API_KEY") ?? "")
  if account == "" then none
  else if token != "" then some(Credentials { account_id: account, token: token, email: "", key: "" })
  else if email != "" and key != "" then some(Credentials { account_id: account, token: "", email: email, key: key })
  else none
}

// Whether a model id can be reached, before anything runs: a missing key is one line.
effect fn check_model(model: String) -> Result[Unit, String] = {
  let _ = live.endpoint(model)!
  ok(())
}

// Whole-request ceiling. Streaming makes a request as long as the generation.
let TOTAL_TIMEOUT_S = 1800
// Silence ceiling. A stream that sends nothing for two minutes is dead.
let IDLE_TIMEOUT_S = 120

// How long one call may run before a second, identical one is started beside
// it. The tail, not the median, is what sets wall time here.
//
// The threshold is measured, not guessed. Eight consecutive calls on this
// project's own task took 25, 26, 29, 46, 47, 73, 117 and 168 seconds: a
// median near 46s and a tail at 117-168s. At 75000 the hedge fired on the
// merely-slow as well as the tail and won 1 of 5 across every run recorded —
// four duplicate requests paid for and discarded to save time once. Since
// golemide's whole claim is cost, the threshold sits above the merely-slow, so a
// second request is spent only where the first is genuinely not arriving.
// `GOLEMIDE_HEDGE_MS=0` turns it off.
effect fn hedge_after_ms() -> Int = int.parse(string.trim(env.get("GOLEMIDE_HEDGE_MS") ?? env.get("CAIRN_HEDGE_MS") ?? "")) ?? 120000

// The wall-clock cap on one request, hedge included. The idle deadline cannot
// catch the failure that costs the most: a model that keeps talking is never
// idle, so it never fires and the whole-request ceiling is the only stop — half an
// hour. One observed call streamed 1.7 MB at 3 KB/s for twelve minutes before
// it was killed by hand. Past this cap the request is abandoned and the loop
// treats it as an attempt that produced nothing; `budget_after` then halves
// the output budget and lowers the effort, which is the right response to a
// generation that would not stop. `GOLEMIDE_CALL_MAX_MS=0` leaves the ceiling as the
// only limit.
effect fn call_max_ms() -> Int = int.parse(string.trim(env.get("GOLEMIDE_CALL_MAX_MS") ?? env.get("CAIRN_CALL_MAX_MS") ?? "")) ?? 360000

// curl's own exit codes, in the vocabulary ask.almd classifies on (almai.live words
// them the same way).
fn transport_error(code: Int, said: String) -> String =
  if code == 28 then "request timeout: no answer within " + int.to_string(TOTAL_TIMEOUT_S) + "s, or no bytes for " + int.to_string(IDLE_TIMEOUT_S) + "s"
  else "transport: curl exit " + int.to_string(code) + (if said == "" then "" else ": " + string.take(said, 300))

// Turn an answer into the response the loop uses, or the error it must see.
fn settle(r: live.Reply, hedged: Bool, won_by_hedge: Bool) -> Result[Response, String] =
  if r.finish == "length" and string.trim(r.content) == "" then {
    // The advice differs by cause, and the wrong advice was being given for the more
    // common cause: when reasoning consumed the budget, a larger budget is the weaker
    // lever, because the reasoning takes the extra room as well.
    let reasoned = string.trim(r.reasoning) != ""
    let cause = if reasoned then ", budget consumed by reasoning" else ""
    let advice = if reasoned then "; spend less on reasoning" else "; raise max_completion_tokens"
    err("truncated before any content (finish_reason=length" + cause + ")" + advice)
  }
  else ok(Response { text: r.content, cost_usd: r.cost_usd, input_tokens: r.input_tokens, output_tokens: r.output_tokens,
    duration_ms: r.ms, hedged: hedged, won_by_hedge: won_by_hedge })

// Cloudflare takes reasoning_effort for every model it serves; elsewhere it is an
// error on a model that does not reason, so it goes to Cloudflare only.
fn effort_for(model: String, effort: String) -> String =
  if (live.split_model(model)).0 == "cf" then effort else ""

fn messages_of(req: Request) -> List[Value] =
  (if req.system == "" then [] else [value.object([("role", value.str("system")), ("content", value.str(req.system))])])
    + [value.object([("role", value.str("user")), ("content", value.str(req.prompt))])]

// One request, hedged: the same body sent a second time if the first is slow,
// and the first answer to land is the one used.
effect fn invoke(creds: Credentials, req: Request) -> Result[Response, String] = {
  let _ = creds
  let ran = live.run(live.Request { model: req.model, messages: messages_of(req), max_tokens: req.max_output_tokens,
      effort: effort_for(req.model, req.reasoning_effort), schema: req.schema },
    live.Limits { total_s: TOTAL_TIMEOUT_S, idle_s: IDLE_TIMEOUT_S }, hedge_after_ms()!, call_max_ms()!)!
  settle(ran.reply, ran.hedged, ran.won_by_hedge)
}

fn reply(content: String, reasoning: String, finish: String) -> live.Reply =
  live.Reply { content: content, reasoning: reasoning, calls: [], finish: finish, cost_usd: 0.0, input_tokens: 10, cached_tokens: 0, output_tokens: 2, ms: 5 }

test "a length finish with no content names the remedy its cause actually calls for" {
  // Reasoning ate the budget: a bigger budget feeds the reasoning, so the remedy is to
  // think less. Measured on glm-5.3: the same prompt at 4096 tokens answers at `low`
  // effort and returns nothing at `high`.
  match settle(reply("", "thinking", "length"), false, false) {
    ok(_) => assert(false),
    err(e) => {
      assert(string.contains(e, "consumed by reasoning"))
      assert(string.contains(e, "spend less on reasoning"))
      assert(not string.contains(e, "raise max_completion_tokens"))
    },
  }
  // No reasoning at all, so the budget really was too small.
  match settle(reply("", "", "length"), false, false) {
    ok(_) => assert(false),
    err(e) => {
      assert(string.contains(e, "raise max_completion_tokens"))
      assert(not string.contains(e, "reasoning"))
    },
  }
  match settle(reply("{\"ok\":true}", "", "stop"), true, false) {
    ok(r) => { assert_eq(r.text, "{\"ok\":true}"); assert(r.hedged) },
    err(e) => assert_eq(e, ""),
  }
}

test "reasoning effort goes to Cloudflare only" {
  assert_eq(effort_for("cf:glm-5.3-flash", "low"), "low")
  assert_eq(effort_for("glm-5.3", "low"), "low")
  assert_eq(effort_for("openai:gpt-5", "low"), "")
  assert_eq(effort_for("claude:sonnet", "low"), "")
  assert_eq(list.len(messages_of(Request { prompt: "p", system: "", model: "m", max_output_tokens: 1, reasoning_effort: "", schema: none })), 1)
}
