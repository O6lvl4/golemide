// `golemide edit` as a sandbox's tool: a WebAssembly component (ci/build-wasm.sh).
//
//   {"path": P, "replacements": [{"old": O, "new": N}]}   or   {"path": P, "source": S}
//   {"path": P, "old": O, "new": N}                        or   {"path": P, "content": S}
//
// on stdin: the request `golemide edit` takes, or the same written flat; the same JSON
// answer on stdout. It is
// the same code: the loose matching of a quoted passage, the refusal to blank a file, the
// check before a write. What it cannot do is start a checker program (wasm/spawn.almd), so
// a write is checked by what golemide checks itself, and the answer says by what.
//
// A host that runs tools for an agent gives a tool its arguments on stdin and its
// settings in the environment:
//
//   GOLEMIDE_ROOT        where the sandbox shows the project (default: .)
//   GOLEMIDE_HOST_ROOT   where the model knows the project to be: a path under it is read
//                        as the same path under GOLEMIDE_ROOT
//   GOLEMIDE_CREATE=1    a file that does not exist may be created

import env
import io
import json
import self.tool

// The request as golemide takes it, from what a tool's caller may have written:
//   - a path the model knows on the host, placed where this sandbox shows the project;
//   - one replacement written flat, {"path", "old", "new"}, which is how a model writes a
//     single edit (and the only shape in which a host can fill a long text into an
//     argument: it fills top-level strings);
//   - "content" for "source", the word other write tools use.
fn placed(request: String, host_root: String) -> String = match json.parse(request) {
  err(_) => request,
  ok(doc) => match value.as_object(doc) {
    err(_) => request,
    ok(rows) => {
      let path = value.get_string(doc, "path") ?? ""
      let inside = if host_root != "" and string.starts_with(path, host_root + "/") then string.drop(path, string.len(host_root) + 1) else path
      let flat = option.is_some(value.get(doc, "old")) and option.is_none(value.get(doc, "replacements"))
      let kept = list.filter(rows, (r) => r.0 != "path" and not (flat and (r.0 == "old" or r.0 == "new")))
      let renamed = list.map(kept, (r) => if r.0 == "content" and option.is_none(value.get(doc, "source")) then ("source", r.1) else r)
      let one = if flat then [("replacements", value.array([value.object([("old", value.get(doc, "old") ?? value.string("")), ("new", value.get(doc, "new") ?? value.string(""))])]))] else []
      json.stringify(value.object([("path", value.string(inside))] + renamed + one))
    },
  },
}

effect fn main() -> Unit = {
  let root = tool.absolute_root(env.get("GOLEMIDE_ROOT") ?? ".", env.cwd() ?? ".")
  let request = placed(io.read_all(), string.trim(env.get("GOLEMIDE_HOST_ROOT") ?? ""))
  match tool.apply_request(root, request, (env.get("GOLEMIDE_CREATE") ?? "") == "1") {
    ok(r) => println(tool.result_json(r)),
    err(e) => println(json.stringify(value.object([("code", value.int(2)), ("error", value.string(e))]))),
  }
}

test "a path the model knows is the same path under the sandbox's root" {
  assert_eq(placed("{\"path\":\"/home/u/proj/src/a.py\",\"source\":\"x\"}", "/home/u/proj"), "{\"path\":\"src/a.py\",\"source\":\"x\"}")
  assert_eq(placed("{\"path\":\"src/a.py\",\"source\":\"x\"}", "/home/u/proj"), "{\"path\":\"src/a.py\",\"source\":\"x\"}")
  assert_eq(placed("not json", "/home/u/proj"), "not json")
  assert_eq(placed("{\"path\":\"a.py\",\"old\":\"x\",\"new\":\"y\"}", ""), "{\"path\":\"a.py\",\"replacements\":[{\"old\":\"x\",\"new\":\"y\"}]}")
  assert_eq(placed("{\"path\":\"a.py\",\"content\":\"x\"}", ""), "{\"path\":\"a.py\",\"source\":\"x\"}")
}
